+bool isNativeMentionWidget(const QWidget *w)
+{
+	return w && (inheritsClass(w, "UserMentionSuggester") || ancestorInheriting(w, "UserMentionSuggester"));
+}
+
+bool nativeMentionVisible(const QWidget *input)
+{
+	if (!input)
+		return false;
+	QWidget *panel = ancestorInheriting(input, "ChatMessagePanel");
+	if (!panel)
+		return false;
+	for (QWidget *candidate : panel->findChildren<QWidget *>()) {
+		if (inheritsClass(candidate, "UserMentionSuggester") && candidate->isVisible()
+		    && ancestorInheriting(candidate, "ChatMessagePanel") == panel)
+			return true;
+	}
+	return false;
+}
